    end)
    logsOpenBtn.MouseLeave:Connect(function()
        TweenService:Create(logsOpenBtn,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(10,20,50)}):Play()
        TweenService:Create(logsOpenStroke,TweenInfo.new(0.12),{Transparency=0.4}):Play()
    end)
