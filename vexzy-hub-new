            if fwd.Magnitude > 0 then fwd = fwd.Unit end
            if rgt.Magnitude > 0 then rgt = rgt.Unit end
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + fwd end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - fwd end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - rgt end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + rgt end
            if UIS:IsKeyDown(Enum.KeyCode.Space)        then move = move + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl)  then move = move - Vector3.new(0,1,0) end
            if move.Magnitude > 0 then
                local delta = move.Unit * SPEED * dt
                sHRP.CFrame  = sHRP.CFrame  + delta
                sHead.CFrame = sHead.CFrame + delta
            end
        end)

