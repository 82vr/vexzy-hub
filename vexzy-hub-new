        ob.MouseLeave:Connect(function() TweenService:Create(ob,TweenInfo.new(0.12),{BackgroundTransparency=0.4}):Play() end)
        ob.MouseButton1Click:Connect(function()
            clickSound()
            if onSelect then onSelect(opt) end
            collapsed=true
            header.Text="▶  "..label..": "..(opt.name or opt)
            TweenService:Create(dd,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{Size=UDim2.new(1,0,0,0)}):Play()
            TweenService:Create(wrapper,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{Size=UDim2.new(1,0,0,30)}):Play()
        end)
    end
    local totalH=#options*ITEM_H
    header.MouseButton1Click:Connect(function()
        clickSound()
        collapsed=not collapsed
        if not collapsed then
            TweenService:Create(dd,TweenInfo.new(0.22,Enum.EasingStyle.Quad),{Size=UDim2.new(1,0,0,totalH)}):Play()
            TweenService:Create(wrapper,TweenInfo.new(0.22,Enum.EasingStyle.Quad),{Size=UDim2.new(1,0,0,30+totalH+4)}):Play()
