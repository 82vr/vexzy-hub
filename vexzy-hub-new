local activeBillboards = {}

local function hideDefaultNametag(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _,child in pairs(head:GetChildren()) do
            if child:IsA("BillboardGui") and child.Name ~= "VexzyBillboard" then
                child.Enabled = false
                child:SetAttribute("VexzyHidden", true)
            end
        end
    end
end

local function restoreDefaultNametag(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Automatic end)
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _,child in pairs(head:GetChildren()) do
            if child:IsA("BillboardGui") and child:GetAttribute("VexzyHidden") then
                child.Enabled = true
                child:SetAttribute("VexzyHidden", nil)
            end
        end
    end
end

local function applyBillboardToHead(head, text, role)
    for _,child in pairs(head:GetChildren()) do
        if child:IsA("BillboardGui") and child.Name == "VexzyBillboard" then child:Destroy() end
    end

    local char = head.Parent
    if not text or text == "" then
        restoreDefaultNametag(char)
        return
    end

    hideDefaultNametag(char)

    local bb = Instance.new("BillboardGui")
    bb.Name        = "VexzyBillboard"
    bb.Size        = UDim2.new(0, 140, 0, 28)
    bb.StudsOffset = Vector3.new(0, 2.0, 0)
    bb.AlwaysOnTop = false
    bb.MaxDistance = 80
    bb.ResetOnSpawn = false
    bb.LightInfluence = 0
    bb.Parent = head

    local bg = Instance.new("Frame", bb)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(6, 6, 18)
    bg.BackgroundTransparency = 0.4
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local tl = Instance.new("TextLabel", bb)
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.Text = text
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 9
    tl.TextStrokeTransparency = 0.4
    tl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    tl.TextXAlignment = Enum.TextXAlignment.Center
    tl.TextYAlignment = Enum.TextYAlignment.Center
    tl.TextTruncate = Enum.TextTruncate.AtEnd

    if role == "owner" then
        tl.TextColor3 = Color3.fromRGB(255, 80, 80)
        task.spawn(function()
            local h = 0
            while tl and tl.Parent do
                h = (h + 4.5) % 360
                tl.TextColor3 = Color3.fromHSV(h/360, 1, 1)
                task.wait(0.03)
            end
        end)
        local stroke = Instance.new("UIStroke", bg)
        stroke.Color = Color3.fromRGB(255,80,80); stroke.Thickness = 1.5; stroke.Transparency = 0.3
        task.spawn(function()
            local h = 0
            while stroke and stroke.Parent do
                h = (h + 4.5) % 360
                stroke.Color = Color3.fromHSV(h/360, 1, 1)
                task.wait(0.03)
            end
        end)
    elseif role == "admin" then
        tl.TextColor3 = Color3.fromRGB(100, 160, 255)
        local stroke = Instance.new("UIStroke", bg)
        stroke.Color = Color3.fromRGB(100,160,255); stroke.Thickness = 1.5; stroke.Transparency = 0.4
        TweenService:Create(stroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            {Transparency = 0.8, Color = Color3.fromRGB(160, 210, 255)}):Play()
    else
        tl.TextColor3 = Color3.fromRGB(220, 230, 255)
    end
end

local function getRoleForPlayer(plr)
    if plr == player and isOwner then return "owner" end
    if plr == player and isAdmin then return "admin" end
    return nil
end

local function applyBillboardToPlayer(plr, text, role)
    if not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if not head then return end
    applyBillboardToHead(head, text, role)
end

local function hookRespawn(plr)
    plr.CharacterAdded:Connect(function(char)
        char:WaitForChild("Head", 10)
        char:WaitForChild("Humanoid", 10)
        task.wait(0.6)
        local entry = activeBillboards[plr.Name]
        if entry then
            local head = char:FindFirstChild("Head")
            if head then
                local text = type(entry)=="table" and entry.text or entry
                local role = type(entry)=="table" and entry.role or nil
                applyBillboardToHead(head, text, role)
            end
        end
    end)
end
