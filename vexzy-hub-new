local _activeSounds = {}

local nowPlayingLabel = nil

local function playSound(soundId, label)
    for _, old in pairs(_activeSounds) do
        pcall(function()
            TweenService:Create(old, TweenInfo.new(0.4), {Volume = 0}):Play()
            task.delay(0.45, function() pcall(function() old:Stop(); old:Destroy() end) end)
        end)
    end
    _activeSounds = {}

    if soundId == "stop" then
        for _, s in pairs(game:GetService("SoundService"):GetDescendants()) do
            if s:IsA("Sound") and s.Playing then pcall(function() s:Stop() end) end
        end
        if nowPlayingLabel then nowPlayingLabel.Text = "♪  Nothing playing" end
        return
    end

    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(soundId)
    s.Volume = 0
    s.RollOffMaxDistance = 0
    s.TimePosition = 0
    s.Parent = game:GetService("SoundService")
    s:Play()

    TweenService:Create(s, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {Volume = 1.2}):Play()

    table.insert(_activeSounds, s)
    game:GetService("Debris"):AddItem(s, 300)

    if nowPlayingLabel and label then
        nowPlayingLabel.Text = "♪  " .. label
    end
end

