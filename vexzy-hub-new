    header.MouseLeave:Connect(function() TweenService:Create(hs,TweenInfo.new(0.12),{Transparency=0.7}):Play() end)
    local dd=Instance.new("Frame",wrapper)
    dd.Size=UDim2.new(1,0,0,0); dd.Position=UDim2.new(0,0,0,32)
    dd.BackgroundColor3=Color3.fromRGB(10,10,22); dd.BorderSizePixel=0; dd.ClipsDescendants=true; dd.ZIndex=12
    Instance.new("UICorner",dd).CornerRadius=UDim.new(0,7)
    local dds=Instance.new("UIStroke",dd); dds.Color=accentColor; dds.Thickness=1; dds.Transparency=0.6
    for i,opt in ipairs(options) do
        local ob=Instance.new("TextButton",dd)
        ob.Size=UDim2.new(1,0,0,ITEM_H); ob.Position=UDim2.new(0,0,0,(i-1)*ITEM_H)
        ob.BackgroundColor3=Color3.fromRGB(20,30,70); ob.BackgroundTransparency=0.4
