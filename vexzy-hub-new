local function lerpColor(a,b,t)
    return Color3.new(a.R+(b.R-a.R)*t, a.G+(b.G-a.G)*t, a.B+(b.B-a.B)*t)
end

local _auraLocks = {}

local function spawnAnimeAura(targetChar, duration, auraStyle)
    if not targetChar then return end
    duration  = duration  or 8
    auraStyle = auraStyle or "ssj"
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local charName = targetChar.Name
    if _auraLocks[charName] then return end
    _auraLocks[charName] = true

    local col = AURA_COLORS[auraStyle] or AURA_COLORS.ssj

    for _, f in pairs(workspace:GetChildren()) do
        if f:IsA("Folder") and f.Name:find("VexzyAura_") then
            if f:GetAttribute("VexzyAuraOwner") == charName then
                pcall(function() f:Destroy() end)
            end
        end
    end

    local folder = Instance.new("Folder")
    folder.Name = "VexzyAura_"..tick()
    folder:SetAttribute("VexzyAuraOwner", charName)
    folder.Parent = workspace

    local WISP_COUNT = 28
    local wisps = {}
    for i = 1, WISP_COUNT do
        local w = Instance.new("Part")
        local wlen = 0.35 + math.random()*0.5
        w.Size = Vector3.new(0.1, wlen, 0.1)
        w.Material = Enum.Material.Neon
        w.Anchored = true; w.CanCollide = false; w.CastShadow = false; w.Transparency = 1
        w.Color = lerpColor(col.c1, col.c2, (i-1)/(WISP_COUNT-1))
        w.Parent = folder
        table.insert(wisps, {
            w       = w,
            angle   = (i-1)*(math.pi*2/WISP_COUNT),
            radius  = 1.8 + math.random()*0.8,
            startOY = -2.8 + math.random()*0.4,
            riseRange = 5.5 + math.random()*2,
            speed   = 0.9 + math.random()*1.0,
            phase   = math.random()*math.pi*2,
            wlen    = wlen,
            orbitSpd = 0.35 + math.random()*0.25,
            swayAmp  = 0.12 + math.random()*0.1,
        })
    end

    local SPARK_COUNT = 16
    local sparks = {}
    for i = 1, SPARK_COUNT do
        local s = Instance.new("Part")
        s.Size = Vector3.new(0.12, 0.12, 0.12)
        s.Shape = Enum.PartType.Ball
        s.Material = Enum.Material.Neon
        s.Anchored = true; s.CanCollide = false; s.CastShadow = false; s.Transparency = 1
        s.Color = col.c3
        s.Parent = folder
        table.insert(sparks, {
            s = s,
            angle   = (i-1)*(math.pi*2/SPARK_COUNT),
            radius  = 1.4,
            heightY = 0.6,
            orbitSpd = 1.4 + math.random()*0.6,
            bobAmp   = 0.18 + math.random()*0.12,
            phase    = math.random()*math.pi*2,
        })
    end

    local RING_COUNT = 20
    local ringParts = {}
    for i = 1, RING_COUNT do
        local r = Instance.new("Part")
        r.Size = Vector3.new(0.18, 0.05, 0.18)
        r.Material = Enum.Material.Neon
        r.Anchored = true; r.CanCollide = false; r.CastShadow = false; r.Transparency = 1
        r.Color = col.ring
        r.Parent = folder
        table.insert(ringParts, {r=r, baseAngle=(i-1)*(math.pi*2/RING_COUNT)})
    end

    local PULSE_COUNT = 24
    local pulseParts = {}
    for i = 1, PULSE_COUNT do
        local p = Instance.new("Part")
        p.Size = Vector3.new(0.1, 0.05, 0.1)
        p.Material = Enum.Material.Neon
        p.Anchored = true; p.CanCollide = false; p.CastShadow = false; p.Transparency = 1
        p.Color = col.ring
        p.Parent = folder
        table.insert(pulseParts, {p=p, baseAngle=(i-1)*(math.pi*2/PULSE_COUNT)})
    end

    local startTime = tick()
    _auraLocks[charName] = nil
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - startTime
        local over    = elapsed >= duration or not targetChar or not targetChar.Parent or not hrp or not hrp.Parent
        local fadeIn  = math.min(elapsed / 0.4, 1)
        local fadeOut = (elapsed > duration - 0.6) and math.min((elapsed - (duration - 0.6)) / 0.6, 1) or 0
        local alpha   = fadeIn * (1 - fadeOut)

        if over and alpha <= 0.01 then
            pcall(function() folder:Destroy() end)
            conn:Disconnect()
            return
        end

        local breathe  = 0.5 + 0.5 * math.sin(elapsed * 3.8)
        local breathe2 = 0.5 + 0.5 * math.sin(elapsed * 2.1 + 1.2)
        local hrpPos   = hrp.Position

        for _, ws in ipairs(wisps) do
            local riseT = ((elapsed * ws.speed + ws.phase) % ws.riseRange) / ws.riseRange
            local y     = hrpPos.Y + ws.startOY + riseT * ws.riseRange
            local rad   = ws.radius + breathe * 0.18
            local sway  = ws.swayAmp * math.sin(elapsed * 2.8 + ws.phase)
            local ang   = ws.angle + elapsed * ws.orbitSpd + sway
            ws.w.CFrame = CFrame.new(
                hrpPos.X + math.cos(ang) * rad,
                y,
                hrpPos.Z + math.sin(ang) * rad
            ) * CFrame.Angles(math.sin(elapsed + ws.phase)*0.3, 0, 0)
            local riseFade = math.sin(riseT * math.pi)
            ws.w.Transparency = math.clamp(1 - riseFade * alpha * (0.75 + 0.25 * breathe), 0, 1)
            ws.w.Size = Vector3.new(0.09, ws.wlen * (0.7 + 0.6 * breathe2 * riseFade), 0.09)
        end

        for _, sp in ipairs(sparks) do
            local ang = sp.angle + elapsed * sp.orbitSpd
            local bob = sp.bobAmp * math.sin(elapsed * 3.2 + sp.phase)
            local rad = sp.radius + breathe * 0.1
            sp.s.CFrame = CFrame.new(
                hrpPos.X + math.cos(ang) * rad,
                hrpPos.Y + sp.heightY + bob,
                hrpPos.Z + math.sin(ang) * rad
            )
            sp.s.Transparency = math.clamp(1 - alpha * (0.6 + 0.4 * breathe), 0, 1)
            local sparkSize = 0.1 + breathe * 0.08
            sp.s.Size = Vector3.new(sparkSize, sparkSize, sparkSize)
        end

        local ringR = 1.6 + breathe * 0.25
        local ringY = hrpPos.Y - 2.8
        for _, rp in ipairs(ringParts) do
            local ang = rp.baseAngle + elapsed * 1.8
            rp.r.CFrame = CFrame.new(hrpPos.X + math.cos(ang)*ringR, ringY, hrpPos.Z + math.sin(ang)*ringR)
            rp.r.Transparency = math.clamp(1 - alpha * (0.55 + breathe * 0.35), 0, 1)
        end

        local pulseT = math.min(elapsed / 0.8, 1)
        local pulseR = 1.0 + pulseT * 2.8
        local pulseA = (1 - pulseT) * alpha
        local pulseY = hrpPos.Y - 2.2
        for _, pp in ipairs(pulseParts) do
            local ang = pp.baseAngle
            pp.p.CFrame = CFrame.new(hrpPos.X + math.cos(ang)*pulseR, pulseY, hrpPos.Z + math.sin(ang)*pulseR)
            pp.p.Transparency = math.clamp(1 - pulseA * 0.9, 0, 1)
        end
    end)
    return folder
end

