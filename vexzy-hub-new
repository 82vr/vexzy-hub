local function proxyPost(endpoint, bodyTable)
    local bodyJson = HttpService:JSONEncode(bodyTable)
    local reqFn = (syn and syn.request) or (http and http.request) or request
    local ok, res = pcall(function()
        return reqFn({
            Url    = PROXY_URL .. endpoint,
            Method = "POST",
            Headers= {["Content-Type"]="application/json"},
            Body   = bodyJson
        })
    end)
    if ok and res then
        return pcall(function() return HttpService:JSONDecode(res.Body) end)
    end
    return false, nil
end

local function proxyGet(endpoint)
    local ok, res = pcall(function()
        return game:HttpGet(PROXY_URL .. endpoint, true)
    end)
    if ok and res then
        return pcall(function() return HttpService:JSONDecode(res) end)
    end
    return false, nil
end

